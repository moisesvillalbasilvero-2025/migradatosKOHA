# ============================================================================
# ARCHIVO DE CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ============================================================================
# Sistema de Importación a Koha - Universidad Nacional de Asunción
#
# INSTRUCCIONES:
# 1. Copiar este archivo como .env en el mismo directorio:
#    cp .env.example .env
#
# 2. Editar .env con tus valores reales (NUNCA commitear .env a git)
#
# 3. El archivo .env será cargado automáticamente por config_manager.py
#
# IMPORTANTE: El archivo .env contiene información sensible y está en .gitignore
# ============================================================================

# -------------------- RUTAS DEL SISTEMA --------------------
# Ruta base del directorio de trabajo (donde está instalado el sistema)
# Por defecto: directorio actual del proyecto
# Ejemplo: /home/usuario/migradatos
KOHA_MIGRA_HOME=/home/mvillalba/migradatos

# Ruta al directorio de exports MARCXML
# Por defecto: $KOHA_MIGRA_HOME/exports
KOHA_MIGRA_EXPORTS=${KOHA_MIGRA_HOME}/exports

# Ruta al directorio de logs
# Por defecto: $KOHA_MIGRA_HOME/logs
KOHA_MIGRA_LOGS=${KOHA_MIGRA_HOME}/logs

# Ruta al directorio de cache/temporal
# Por defecto: $KOHA_MIGRA_HOME/.cache
KOHA_MIGRA_CACHE=${KOHA_MIGRA_HOME}/.cache

# Ruta al directorio de vigilancia (importar_aqui)
# Por defecto: $KOHA_MIGRA_HOME/importar_aqui
KOHA_MIGRA_WATCH_DIR=${KOHA_MIGRA_HOME}/importar_aqui

# -------------------- CONFIGURACIÓN KOHA --------------------
# Nombre de la instancia de Koha
KOHA_INSTANCE=koha-cnc

# Ubicación por defecto para items (SALA, DEPOSITO, etc.)
KOHA_LOC_DEFAULT=SALA

# -------------------- CONFIGURACIÓN FIREBIRD (Ejemplos) --------------------
# IMPORTANTE: Configurar solo las bibliotecas que uses
# Formato: FIREBIRD_<CODIGO>_<PARAMETRO>

# Ejemplo: Biblioteca POL
# FIREBIRD_POL_HOST=localhost
# FIREBIRD_POL_PORT=3050
# FIREBIRD_POL_DATABASE=/var/lib/firebird/data/pol_biblio.fdb
# FIREBIRD_POL_USER=SYSDBA
# FIREBIRD_POL_PASSWORD=tu_password_aqui
# FIREBIRD_POL_CHARSET=UTF8

# Ejemplo: Biblioteca FACAGR (remota)
# FIREBIRD_FACAGR_HOST=192.168.1.10
# FIREBIRD_FACAGR_PORT=3050
# FIREBIRD_FACAGR_DATABASE=/datos/biblio.fdb
# FIREBIRD_FACAGR_USER=SYSDBA
# FIREBIRD_FACAGR_PASSWORD=password_seguro
# FIREBIRD_FACAGR_CHARSET=UTF8

# -------------------- CONFIGURACIÓN DE EMAIL (Opcional) --------------------
# Activar notificaciones por email (true/false)
EMAIL_ENABLED=false

# Servidor SMTP
EMAIL_SMTP_SERVER=smtp.una.py
EMAIL_SMTP_PORT=587

# Credenciales SMTP
EMAIL_USER=biblioteca@una.py
EMAIL_PASSWORD=

# Destinatarios (separados por coma)
EMAIL_RECIPIENTS=admin@una.py,biblioteca@una.py

# -------------------- PARÁMETROS DE RENDIMIENTO --------------------
# Tamaño de chunk para procesamiento
KOHA_CHUNK_SIZE=2000

# Tamaño de commit para importaciones
KOHA_COMMIT_SIZE=1000

# Número máximo de registros por archivo XML
KOHA_MAX_RECORDS_PER_FILE=5000

# Número de workers paralelos (0 = auto-detectar)
KOHA_NUM_WORKERS=0

# -------------------- TIMEOUTS (en segundos) --------------------
# Timeout para generación de MARCXML
KOHA_TIMEOUT_MARCXML=900

# Timeout para importación
KOHA_TIMEOUT_IMPORT=2400

# Timeout para reindexación
KOHA_TIMEOUT_REINDEX=1200

# -------------------- CONFIGURACIÓN DE CACHE --------------------
# Activar caché de verificaciones (true/false)
KOHA_CACHE_ENABLED=true

# TTL del caché en segundos
KOHA_CACHE_TTL=3600

# -------------------- CONFIGURACIÓN DE LOGGING --------------------
# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Activar modo verbose por defecto (true/false)
LOG_VERBOSE=true

# -------------------- CONFIGURACIÓN DE SEGURIDAD --------------------
# Activar validación estricta de CSV (true/false)
VALIDATION_STRICT=false

# Crear backup antes de importar (true/false)
BACKUP_BEFORE_IMPORT=true

# Pausar entre bibliotecas (segundos)
PAUSE_BETWEEN_IMPORTS=5

# Número de reintentos en caso de error
MAX_RETRIES=3

# ============================================================================
# NOTAS IMPORTANTES:
# ============================================================================
#
# 1. Las contraseñas y credenciales NUNCA deben ser commiteadas a git
# 2. El archivo .env está automáticamente en .gitignore
# 3. Usar comillas dobles para valores con espacios: VAR="valor con espacios"
# 4. Las variables pueden referenciar otras con ${OTRA_VAR}
# 5. true/false deben ser minúsculas
# 6. Los números no requieren comillas
#
# PERMISOS RECOMENDADOS:
#   chmod 600 .env
#   chown usuario:usuario .env
#
# ============================================================================
