  "personalizacion": {
    "descripcion": "Cómo agregar nuevos tipos",
    "pasos": [
      "1. Identifica el nombre que usa tu CSV (ej: 'Datasheet')",
      "2. Decide el código Koha apropiado (ej: 'CAT' para catálogos)",
      "3. Agrega entrada en itemtype_map:",
      "   \"Datasheet\": \"CAT\"",
      "4. Asegúrate que el código existe en Koha Administration > Item Types",
      "5. Prueba con archivo pequeño"
    ],
    "ejemplo_agregar": {
      "situacion": "Tu biblioteca tiene 'Kits de Arduino'",
      "solucion": {
        "itemtype_map": {
          "Kit Arduino": "KIT",
          "Kit de Desarrollo": "KIT",
          "Kit Educativo": "KIT"
        },
        "nota": "Primero crea el tipo 'KIT' en Koha Admin si no existe"
