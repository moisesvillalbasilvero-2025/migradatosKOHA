    "Book": "BK",

    "Revista": "MG",
    "Magazine": "MG",
    "Periódico": "MG",

    "DVD": "VM",
    "Video": "VM",
    "Película": "VM",

    "CD": "MU",
    "CD-ROM": "MU",
    "Audio": "MU",

    "Mapa": "MP",
    "Map": "MP",
    "Plano": "MP",

    "Tesis": "TES",
    "Thesis": "TES",
    "Trabajo de Grado": "TES"
  },

  "como_agregar_nuevo_campo": {
    "_titulo": "GUÍA: Cómo Agregar un Nuevo Campo",
    "_pasos": [
      "1. Identifica el nombre de la columna en tu CSV",
      "2. Agrega entrada en 'mapeo_columnas_csv' con las variantes posibles",
      "3. Determina qué campo MARC21 corresponde (consulta https://www.loc.gov/marc/)",
      "4. Agrega entrada en 'mapeo_marc21' especificando tag, subfields e indicators",
      "5. Si necesitas lógica especial, modifica opac_exportar.py",
      "6. Prueba con un archivo CSV pequeño en modo dry-run"
    ],
    "_ejemplo_completo": {
      "situacion": "Quieres agregar campo 'Idioma Original' de la obra",
      "paso_1_csv": {
        "descripcion": "Tu CSV tiene columna 'idioma_orig'",
        "mapeo_columnas_csv": {
          "idioma_original": {
            "nombre_legible": "Idioma Original",
            "descripcion": "Idioma en que se escribió originalmente la obra",
            "variantes_csv": ["idioma_orig", "idioma_original", "original_language"],
            "obligatorio": false,
            "ejemplo": "español, inglés"
          }
        }
      },
      "paso_2_marc": {
        "descripcion": "Campo MARC 041 para idiomas",
        "mapeo_marc21": {
          "041": {
            "nombre": "Código de Idioma",
            "fuente": "idioma_original",
            "subfields": {
              "a": "Código de idioma (3 letras ISO 639-2)"
            },
            "ejemplo": "041  $a spa",
            "nota": "Requiere convertir nombre a código: 'español' → 'spa'"
          }
        }
      }
    }
  }
}
